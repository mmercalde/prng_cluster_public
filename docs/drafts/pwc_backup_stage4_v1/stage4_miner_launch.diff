+# --- STAGE4-PARAMS BEGIN ---
+# [STAGE 4, Beta X-PWC-STAGE4 R1 Q8] The run's params are loaded and validated HERE, before
+# any gate, clean slate or fleet step. An unreadable or invalid file stops the launcher;
+# it is never passed on as an empty --params (WATCHER skips an empty value and would run on
+# the manifest defaults, agents/watcher_agent.py:4173, including the live staging_dir).
+STAGE4_PARAMS_FILE=logs/stage4/params.json
+STAGE4_PARAMS=$(python3 - "$STAGE4_PARAMS_FILE" agent_manifests/window_optimizer.json <<'S4EOF'
+import json, os, sys
+def no(msg):
+    print(f"STAGE 4 REFUSED: {msg}", file=sys.stderr); sys.exit(1)
+try:
+    p = json.load(open(sys.argv[1], encoding="utf-8"))
+except (OSError, ValueError) as e:
+    no(f"cannot read params {sys.argv[1]}: {e}")
+if not isinstance(p, dict):
+    no("params is not a JSON object")
+if p.get("use_range_miner") is not True or p.get("use_persistent_workers") is not False:
+    no("params are not a RANGE-MINER run (use_range_miner true, use_persistent_workers false)")
+need = ["prng_type", "max_seeds", "test_both_modes", "window_trials", "n_parallel",
+        "warm_start_window", "warm_start_offset", "warm_start_session_idx",
+        "warm_start_fwd_thresh", "warm_start_rev_thresh", "warm_start_skip_min",
+        "warm_start_skip_max", "staging_dir"]
+miss = [k for k in need if k not in p]
+if miss:
+    no(f"params lack {miss}")
+st = p["staging_dir"]
+if not isinstance(st, str) or not os.path.isabs(st):
+    no(f"staging_dir {st!r} is not an absolute path")
+try:
+    m = json.load(open(sys.argv[2], encoding="utf-8"))
+    live = (m.get("default_params") or {}).get("staging_dir") or m.get("staging_dir")
+except (OSError, ValueError) as e:
+    no(f"cannot read the manifest {sys.argv[2]} to find the live staging_dir: {e}")
+if not live:
+    no("the manifest names no staging_dir, so the live one cannot be excluded")
+rs, rl = os.path.realpath(st), os.path.realpath(live)
+if rs == rl or rs.startswith(rl + os.sep) or rl.startswith(rs + os.sep):
+    no(f"staging_dir {st} is or overlaps the live staging_dir {live}")
+if not os.path.isdir(st):
+    no(f"staging_dir {st} does not exist (Phase A creates it, empty)")
+if os.listdir(st):
+    no(f"staging_dir {st} is not empty: a Stage 4 run starts a fresh miner ledger")
+print(json.dumps(p, separators=(",", ":"), sort_keys=True))
+S4EOF
+) || { echo "STAGE 4 ABORTED before any gate: params invalid (see the line above)"; exit 1; }
+if [ -z "$STAGE4_PARAMS" ]; then echo "STAGE 4 ABORTED: params validated to nothing"; exit 1; fi
+# The shared halt flag (agents/safety/kill_switch.py:60) is honoured, never cleared here:
+# a present flag is someone's halt, so the launcher stops instead of passing --clear-halt.
+STAGE4_HALT=$(python3 -c "from agents.safety.kill_switch import KillSwitch; print(KillSwitch().halt_file_path)") \
+  || { echo "STAGE 4 ABORTED: halt-file path not derivable"; exit 1; }
+if [ -e "$STAGE4_HALT" ]; then
+  echo "STAGE 4 ABORTED: halt file $STAGE4_HALT is present; ask the owner, do not clear it"; exit 1
+fi
+echo "STAGE 4 params validated: $STAGE4_PARAMS"
+# --- STAGE4-PARAMS END ---
