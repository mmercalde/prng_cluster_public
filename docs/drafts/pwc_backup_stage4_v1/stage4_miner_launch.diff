   --start-step 1 --end-step 1 \
-  --params '{"use_persistent_workers": false, "use_range_miner": true,
-             "worker_pool_size": 25,
-             "seed_start": 0, "max_seeds": 2147483648,
-             "miner_stripe_size": 67108864, "test_both_modes": true,
