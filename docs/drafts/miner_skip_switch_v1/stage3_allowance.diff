+SWITCH_WOI = ['            # [SKIP-DELIVERY SWITCH] passed ONLY when on, so a baseline call is unchanged\n            **({"deliver_skip_range": True}\n               if getattr(coordinator, \'deliver_skip_range\', False) is True else {}),\n', "        _step1_skip_delivery_preflight(\n            _s1_search_ctx, getattr(self, 'deliver_skip_range', False) is True)\n", 'SKIP_DELIVERY_SEARCH_KEY = "constant_skip_delivery"     # utils/step1_search_ledger.py\n\n\ndef _step1_skip_delivery_preflight(search_ctx, deliver_on):\n    """[SKIP-DELIVERY SWITCH] Switched-on trials never share a search, and so (S9) never\n    a study, with baseline trials (docs/drafts/miner_skip_switch_v1/PLAN.md §4). A\n    switched-on run must name a search opened with the switch; a baseline run must not\n    use one. Raises Step1SearchPreflightError before any study or dispatch."""\n    recorded = None\n    if search_ctx is not None:\n        space = search_ctx["record"].search_space or {}\n        recorded = space.get(SKIP_DELIVERY_SEARCH_KEY) if isinstance(space, dict) else None\n    if deliver_on and search_ctx is None:\n        raise Step1SearchPreflightError(\n            "--deliver-skip-range needs a Step 1 search (--step1-search-id) opened with "\n            "deliver_skip_range: true, so its trials get a study of their own")\n    if deliver_on and recorded != "trial_range":\n        raise Step1SearchPreflightError(\n            f"--deliver-skip-range: search {search_ctx[\'record\'].search_id} was opened "\n            f"without it (search_space.{SKIP_DELIVERY_SEARCH_KEY}={recorded!r}); open a "\n            f"separate search with deliver_skip_range: true")\n    if not deliver_on and recorded is not None:\n        raise Step1SearchPreflightError(\n            f"search {search_ctx[\'record\'].search_id} was opened with "\n            f"deliver_skip_range ({SKIP_DELIVERY_SEARCH_KEY}={recorded!r}); a baseline "\n            f"run may not add trials to it")\n\n\n']
+SWITCH_WO = ['    deliver_skip_range: bool = False,       # [SKIP-DELIVERY SWITCH] hop 2 of 3\n', '    if deliver_skip_range is True:\n        # [SKIP-DELIVERY SWITCH] set ONLY when on: a baseline coordinator is unchanged\n        coordinator.deliver_skip_range = True\n        print("   [SKIP-DELIVERY] ON: RANGE-MINER phases 1-2 sieve each trial\'s own "\n              "[skip_min, skip_max] (baseline: [0, 16])")\n', '    parser.add_argument(\'--deliver-skip-range\', action=\'store_true\', default=False,\n                        help=\'[SKIP-DELIVERY SWITCH] RANGE-MINER phases 1-2 sieve the \'\n                             "trial\'s own [skip_min, skip_max] instead of the baseline "\n                             \'[0, 16]. Off by default; needs --use-range-miner and a \'\n                             \'Step 1 search opened with deliver_skip_range: true\')\n', '    if getattr(args, \'deliver_skip_range\', False) and not args.use_range_miner:\n        parser.error("--deliver-skip-range applies to the RANGE-MINER route only "\n                     "(--use-range-miner); PWC already sends the trial\'s skip range")\n\n', "            deliver_skip_range=getattr(args, 'deliver_skip_range', False),  # SKIP-DELIVERY\n"]
+
+
+def strip_switch(src, snippets, label):
+    for s in snippets:
+        n = src.count(s)
+        assert n == 1, (f"{label}: the skip-switch addition occurs {n} times (it must occur "
+                        f"exactly once, verbatim): {s[:90]!r}")
+        src = src.replace(s, "")
+    return src
+
