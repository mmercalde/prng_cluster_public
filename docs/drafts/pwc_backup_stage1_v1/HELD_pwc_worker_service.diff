@@ -754,10 +754,26 @@ class PWCWorkerService:
 # Entry point
 # ---------------------------------------------------------------------------
 
+def _required_env(name: str) -> str:
+    """[PWC-BACKUP S3/S4] The dial target has no fallback. This worker used to
+    default PWC_HOST to 192.168.3.127 (the FROZEN bare-metal Zeus, CLAUDE.md §0)
+    and PWC_PORT to 5600, and the coordinator exported neither, so every rig
+    worker dialled .127:5600 whatever the coordinator had bound. Unset now exits
+    non-zero, naming the variable, before any connection is attempted."""
+    value = os.environ.get(name, "").strip()
+    if not value:
+        log.error(
+            f"[PWC-BACKUP] {name} is not set — refusing to start. The coordinator "
+            f"exports it in the launch script (persistent_worker_coordinator.py, "
+            f"_tcp_launch_workers); this worker has no default dial target.")
+        sys.exit(2)
+    return value
+
