+# Step-1 phase numbering used by the credit gate (`credit_decision`,
+# utils/step1_search_ledger.py) and the legacy evidence builder
+# (window_optimizer_integration_final.py, `_legacy_phase_results`).
+PWC_PHASES = (
+    ("1", "forward", "constant"),
+    ("2", "reverse", "constant"),
+    ("3", "forward", "variable"),
+    ("4", "reverse", "variable"),
+)
