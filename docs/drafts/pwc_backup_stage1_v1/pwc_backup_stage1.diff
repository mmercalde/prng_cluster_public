+# ── [S1] completion accounting ──────────────────────────────────────────────
+PWC_PASS_ACCOUNTING_SCHEMA  = "pwc_pass_accounting_v1"
+PWC_TRIAL_COMPLETION_SCHEMA = "pwc_trial_completion_v1"
