+    r = run_isolated(loc)
+    assert r["rc"] == 0 and r["stdout"][-1:] == [ok], r
+    assert r["alive_pwc"] == 0 and r["alive_sieve"] == 1, f"local kill must touch only pwc: {r}"
+    r = run_isolated(loc, dummies=False, fake="pgrep_blind")
+    assert r["rc"] == M.PWC_KILL_EXIT_UNAVAILABLE, r
