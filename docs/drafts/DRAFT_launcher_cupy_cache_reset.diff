+# (/tmp/cupy_cache_gpu$N, in its CT) is emptied immediately before that worker starts, so every phase
+# compiles cold. Default 0: the remote command is byte-identical to today's. Basis: docs/LEADS.md L-7
+# (2026-11-16 Runs A-E: every warm phase-4 path faulted on rrig6600/rrig6600c; every cold one was clean).
+RIG_CUPY_CACHE_RESET="${RIG_CUPY_CACHE_RESET:-0}"
+case "$RIG_CUPY_CACHE_RESET" in 0|1) ;; *) echo "[launch] FATAL: RIG_CUPY_CACHE_RESET must be 0 or 1" >&2; exit 64;; esac
