+# verify_cache_records: after all dispatches, every rig dispatch log must carry exactly ONE "[cache] OK"
+# record for THIS tag, whose gpu, path and pid match that worker's expected gpu/path and its launch ACK.
+# Writes $LOGDIR/cache_records_<tag>.tsv (kept with the run evidence). Returns nonzero on any defect.
+verify_cache_records() {
+    local i=0 bad=0 log exp gpu ack rec n out="$LOGDIR/cache_records_${CACHE_TAG}.tsv"
+    printf 'label\ttag\thost\tgpu\tpath\tpid\tt_prep\tenv\tverdict\n' > "$out"
+    while [ "$i" -lt "${#REMOTE_DISPATCH_LOGS[@]}" ]; do
+        log="${REMOTE_DISPATCH_LOGS[$i]}"; exp="${REMOTE_DISPATCH_CACHE[$i]}"; gpu="${REMOTE_DISPATCH_GPU[$i]}"
+        ack="$(grep -o 'started pid=[0-9][0-9]*' "$log" 2>/dev/null | head -1 | cut -d= -f2)"
+        n="$(grep -c "^\[cache\] OK tag=${CACHE_TAG} " "$log" 2>/dev/null)"; n="${n:-0}"
+        rec="$(grep "^\[cache\] OK tag=${CACHE_TAG} " "$log" 2>/dev/null | head -1)"
+        v=OK
+        if [ "$n" -ne 1 ]; then v="records=$n"
+        elif ! printf '%s' "$rec" | grep -q " gpu=$gpu policy=per_run path=$exp created=exclusive entries=0 "; then v=path_or_gpu_mismatch
+        elif [ -z "$ack" ] || ! printf '%s' "$rec" | grep -q " pid=$ack env_CUPY_CACHE_DIR=$exp\$"; then v=pid_or_env_mismatch
+        fi
+        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${REMOTE_DISPATCH_LABELS[$i]}" "$CACHE_TAG" \
+            "$(printf '%s' "$rec" | sed -n 's/.* host=\([^ ]*\) .*/\1/p')" "$gpu" "$exp" "$ack" \
+            "$(printf '%s' "$rec" | sed -n 's/.* t_prep=\([^ ]*\) .*/\1/p')" \
+            "$(printf '%s' "$rec" | sed -n 's/.* env_CUPY_CACHE_DIR=\(.*\)$/\1/p')" "$v" >> "$out"
+        [ "$v" = OK ] || { bad=$((bad + 1)); echo "[launch] *** CACHE RECORD DEFECT: ${REMOTE_DISPATCH_LABELS[$i]}: $v (see $log) ***" >&2; }
+        i=$((i + 1))
+    done
+    echo "[launch] cache records: $(( ${#REMOTE_DISPATCH_LOGS[@]} - bad )) OK of ${#REMOTE_DISPATCH_LOGS[@]} -> $out"
+    return "$bad"
+}
