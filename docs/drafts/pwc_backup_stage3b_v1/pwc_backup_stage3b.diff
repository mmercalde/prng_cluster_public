+        (sorted(set(pb) - set(pa)))
+    return (f"use_range_miner=True (Run-4 shape): {len(b['attrs'])} coordinator attributes and the "
+            f"optimize_window arguments identical to {BASE}; control: a PWC run gains exactly "
